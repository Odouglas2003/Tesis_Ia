.git
.gitignore

# Archivos de entorno (muy importante ignorarlos)
.env
.env.*

# Carpetas de IDE
.vscode
.idea
*.swp
*.swo
*~

# Archivos de Sistema Operativo
.DS_Store
Thumbs.db

# Logs
logs
*.log

